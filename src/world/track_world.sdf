            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>300 300</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.42 0.62 0.42 1</ambient>
            <diffuse>0.42 0.62 0.42 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

