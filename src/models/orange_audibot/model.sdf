<?xml version="1.0" ?>
<sdf version="1.11">
    <model name='orange_audibot'>
        <link name="base_footprint">
            <pose>0 0 0 0 0 0</pose>
            <sensor name="navsat_sensor" type="navsat">
                <always_on>1</always_on>
                <update_rate>1</update_rate>
                <topic>/navsat</topic>
            </sensor>
        </link>

        <link name="chassis">
            <sensor name="imu_sensor" type="imu">
                <always_on>1</always_on>
                <update_rate>50</update_rate>
                <visualize>false</visualize>
                <topic>/imu</topic>
            </sensor>
            <pose>0 0 0.36 0 0 0</pose>

            <visual name="visual_chassis">
                <pose>1.37 0 0.03 0 0 0</pose>
                <geometry>
                    <mesh>
                        <uri>model://orange_audibot/meshes/body.dae</uri>
                    </mesh>
                </geometry>
            </visual>
            <collision name="collision_chassis">
                <pose>1.37 0 0.03 0 0 0</pose>
                <geometry>
                    <mesh>
                        <uri>model://orange_audibot/meshes/body_collision.stl</uri>
                    </mesh>
                </geometry>
            </collision>

            <inertial>
                <pose>1.37 0 0.03 0 0 0</pose>
                <mass>1620.0</mass>
                <inertia>
                    <ixx>556.54</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>1819.6</iyy>
                    <iyz>0</iyz>
                    <izz>1954.3</izz>
                </inertia>
            </inertial>
        </link>

        <link name="wheel_rl">
            <pose>0.0 0.8 0.361 -1.57079632679 0 0</pose>
            <visual name="visual_wheel_rl">
                <pose>0 0 0 1.57079632679 3.1415926535 0</pose>
                <geometry><mesh><uri>model://orange_audibot/meshes/wheel.dae</uri></mesh></geometry>
            </visual>
            <collision name="collision_wheel_rl">
                <geometry><cylinder><radius>0.36</radius><length>0.25</length></cylinder></geometry>
            </collision>
            <inertial>
                <mass>40.0</mass>
                <inertia><ixx>1.5043</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1.5043</iyy><iyz>0</iyz><izz>2.5920</izz></inertia>
            </inertial>
        </link>
        <joint name="wheel_rl_joint" type="revolute">
            <parent>chassis</parent><child>wheel_rl</child>
            <axis><xyz>0 0 1</xyz><limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit><dynamics><damping>0.1</damping><spring_reference>0.0</spring_reference><spring_stiffness>0.0</spring_stiffness></dynamics></axis>
        </joint>

        <link name="wheel_rr">
            <pose>0.0 -0.8 0.361 -1.57079632679 0 0</pose>
            <visual name="visual_wheel_rr">
                <pose>0 0 0 1.57079632679 0 0</pose>
                <geometry><mesh><uri>model://orange_audibot/meshes/wheel.dae</uri></mesh></geometry>
            </visual>
            <collision name="collision_wheel_rr">
                <geometry><cylinder><radius>0.36</radius><length>0.25</length></cylinder></geometry>
            </collision>
            <inertial>
                <mass>40.0</mass>
                <inertia><ixx>1.5043</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1.5043</iyy><iyz>0</iyz><izz>2.5920</izz></inertia>
            </inertial>
        </link>
        <joint name="wheel_rr_joint" type="revolute">
            <parent>chassis</parent><child>wheel_rr</child>
            <axis><xyz>0 0 1</xyz><limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit><dynamics><damping>0.1</damping><spring_reference>0.0</spring_reference><spring_stiffness>0.0</spring_stiffness></dynamics></axis>
        </joint>

        <link name="wheel_fl">
            <pose>2.67 0.819 0.361 -1.57079632679 0 0</pose>
            <visual name="visual_wheel_fl">
                <pose>0 0 0 1.57079632679 3.1415926535 0</pose>
                <geometry><mesh><uri>model://orange_audibot/meshes/wheel.dae</uri></mesh></geometry>
            </visual>
            <collision name="collision_wheel_fl">
                <geometry><cylinder><radius>0.36</radius><length>0.25</length></cylinder></geometry>
            </collision>
            <inertial>
                <mass>40.0</mass>
                <inertia><ixx>1.5043</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1.5043</iyy><iyz>0</iyz><izz>2.5920</izz></inertia>
            </inertial>
        </link>
        <link name="steer_fl" >
            <pose>2.67 0.819 0.361 0 0 0</pose>
            <inertial><mass>1.0</mass><inertia><ixx>0.05</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.05</iyy><iyz>0</iyz><izz>0.05</izz></inertia></inertial>
        </link>
        <joint name="wheel_fl_joint" type="revolute">
            <parent>steer_fl</parent><child>wheel_fl</child>
            <axis><xyz>0 0 1</xyz><limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit><dynamics><damping>0.1</damping><spring_reference>0.0</spring_reference><spring_stiffness>0.0</spring_stiffness></dynamics></axis>
        </joint>
        <joint name="steer_fl_joint" type="revolute">
            <parent>chassis</parent><child>steer_fl</child>
            <axis><xyz>0 0 1</xyz><limit><lower>-0.55</lower><upper>0.55</upper><effort>1000000</effort><velocity>1.0</velocity></limit></axis>
        </joint>

        <link name="wheel_fr">
            <pose>2.67 -0.819 0.361 -1.57079632679 0 0</pose>
            <visual name="visual_wheel_fr">
                <pose>0 0 0 1.57079632679 0 0</pose>
                <geometry><mesh><uri>model://orange_audibot/meshes/wheel.dae</uri></mesh></geometry>
            </visual>
            <collision name="collision_wheel_fr">
                <geometry><cylinder><radius>0.36</radius><length>0.25</length></cylinder></geometry>
            </collision>
            <inertial>
                <mass>40.0</mass>
                <inertia><ixx>1.5043</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1.5043</iyy><iyz>0</iyz><izz>2.5920</izz></inertia>
            </inertial>
        </link>
        <link name="steer_fr" >
            <pose>2.67 -0.819 0.361 0 0 0</pose>
            <inertial><mass>1.0</mass><inertia><ixx>0.05</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.05</iyy><iyz>0</iyz><izz>0.05</izz></inertia></inertial>
        </link>
        <joint name="wheel_fr_joint" type="revolute">
            <parent>steer_fr</parent><child>wheel_fr</child>
            <axis><xyz>0 0 1</xyz><limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit><dynamics><damping>0.1</damping><spring_reference>0.0</spring_reference><spring_stiffness>0.0</spring_stiffness></dynamics></axis>
        </joint>
        <joint name="steer_fr_joint" type="revolute">
            <parent>chassis</parent><child>steer_fr</child>
            <axis><xyz>0 0 1</xyz><limit><lower>-0.55</lower><upper>0.55</upper><effort>1000000</effort><velocity>1.0</velocity></limit></axis>
        </joint>

        <link name="camera">
            <pose>2.0 0 1.5 0 0.25 0</pose>
            <inertial><mass>0.1</mass><inertia><ixx>0.000166667</ixx><iyy>0.000166667</iyy><izz>0.000166667</izz></inertia></inertial>
            <collision name="collision"><geometry><box><size>0.1 0.1 0.1</size></box></geometry></collision>
            <visual name="visual"><geometry><box><size>0.1 0.1 0.1</size></box></geometry></visual>
            <sensor name="camera_sensor" type="rgbd_camera">
                <always_on>0</always_on><update_rate>5</update_rate>
                <camera>
                    <horizontal_fov>1.047</horizontal_fov>
                    <image><width>1920</width><height>1080</height><format>R8G8B8</format></image>
                    <clip><near>0.1</near><far>20</far></clip>
                    <optical_frame_id>camera_optical</optical_frame_id>
                    <camera_info_topic>/camera/camera_info</camera_info_topic>
                </camera>
                <topic>camera</topic><frame_id>camera</frame_id>
            </sensor>
        </link>
        <link name="camera_optical">
            <pose relative_to="camera">0 0 0 -1.570796326 0 -1.570796326</pose>
        </link>
        <joint name="chassis_joint" type="fixed"><parent>base_footprint</parent><child>chassis</child></joint>
        <joint name="camera_joint" type="fixed"><parent>chassis</parent><child>camera</child></joint>
        <joint name="camera_optical_joint" type="fixed"><parent>camera</parent><child>camera_optical</child></joint>

        <link name="camera_left">
            <pose>1.5 0.9 0.8 0 0.5 1.5708</pose> 
            <sensor name="cam_left_sensor" type="camera">
                <always_on>0</always_on><update_rate>5</update_rate>
                <camera>
                    <horizontal_fov>1.745</horizontal_fov>
                    <image><width>1920</width><height>1080</height><format>R8G8B8</format></image>
                    <clip><near>0.1</near><far>20</far></clip>
                    <camera_info_topic>/camera_left/camera_info</camera_info_topic>
                </camera>
                <topic>/camera_left/image</topic>
            </sensor>
        </link>
        <joint name="camera_left_joint" type="fixed"><parent>chassis</parent><child>camera_left</child></joint>

        <link name="camera_right">
            <pose>1.5 -0.9 0.8 0 0.5 -1.5708</pose> 
            <sensor name="cam_right_sensor" type="camera">
                <always_on>0</always_on><update_rate>5</update_rate>
                <camera>
                    <horizontal_fov>1.745</horizontal_fov>
                    <image><width>1920</width><height>1080</height><format>R8G8B8</format></image>
                    <clip><near>0.1</near><far>20</far></clip>
                    <camera_info_topic>/camera_right/camera_info</camera_info_topic>
                </camera>
                <topic>/camera_right/image</topic>
            </sensor>
        </link>
        <joint name="camera_right_joint" type="fixed"><parent>chassis</parent><child>camera_right</child></joint>

        <link name="camera_front">
            <pose>3.7 0.0 2.08 0 -0.15 0</pose> 
            <sensor name="cam_front_sensor" type="camera">
                <always_on>0</always_on><update_rate>10</update_rate>
                <camera>
                    <horizontal_fov>1.65</horizontal_fov> 
                    <image><width>1280</width><height>720</height><format>R8G8B8</format></image>
                    <clip><near>0.1</near><far>16</far></clip>
                    <camera_info_topic>/camera_front/camera_info</camera_info_topic>
                </camera>
                <topic>/camera_front/image</topic>
            </sensor>
        </link>
        <joint name="camera_front_joint" type="fixed"><parent>chassis</parent><child>camera_front</child></joint>

        <link name="camera_rear">
            <pose>-1.2 0.0 0.8 0 0.5 3.14159</pose> 
            <sensor name="cam_rear_sensor" type="camera">
                <always_on>0</always_on><update_rate>5</update_rate>
                <camera>
                    <horizontal_fov>1.745</horizontal_fov> 
                    <image><width>1920</width><height>1080</height><format>R8G8B8</format></image>
                    <clip><near>0.1</near><far>20</far></clip>
                    <camera_info_topic>/camera_rear/camera_info</camera_info_topic>
                </camera>
                <topic>/camera_rear/image</topic>
            </sensor>
        </link>
        <joint name="camera_rear_joint" type="fixed"><parent>chassis</parent><child>camera_rear</child></joint>

    <link name="camera_god">
            <pose>0.0 0.0 15.0 0 1.570796326 0</pose> 
            <sensor name="cam_god_sensor" type="camera">
                <always_on>1</always_on>
                <update_rate>10</update_rate> <camera>
                    <horizontal_fov>1.047</horizontal_fov> 
                    <image>
                        <width>800</width>
                        <height>800</height>
                        <format>R8G8B8</format>
                    </image>
                    <clip><near>0.1</near><far>30</far></clip>
                    <camera_info_topic>/camera_god/camera_info</camera_info_topic>
                </camera>
                <topic>/camera_god/image</topic>
            </sensor>
        </link>
        <joint name="camera_god_joint" type="fixed">
            <parent>chassis</parent>
            <child>camera_god</child>
        </joint>

        <plugin
            filename="gz-sim-ackermann-steering-system"
            name="gz::sim::systems::AckermannSteering">

            <!-- 后轮驱动关节 -->
            <left_joint>wheel_rl_joint</left_joint>
            <right_joint>wheel_rr_joint</right_joint>

            <!-- 前轮转向关节 -->
            <left_steering_joint>steer_fl_joint</left_steering_joint>
            <right_steering_joint>steer_fr_joint</right_steering_joint>

            <!-- 左右后轮中心距离 -->
            <wheel_separation>1.6</wheel_separation>

            <!-- 左右转向主销距离 -->
            <kingpin_width>1.638</kingpin_width>

            <!-- 前后轮轴距 -->
            <wheel_base>2.67</wheel_base>

            <!-- 车轮半径 -->
            <wheel_radius>0.36</wheel_radius>

            <!-- 最大转向角，单位为弧度 -->
            <steering_limit>0.55</steering_limit>

            <!-- 速度和加速度限制 -->
            <min_velocity>-5.0</min_velocity>
            <max_velocity>5.0</max_velocity>
            <min_acceleration>-3.0</min_acceleration>
            <max_acceleration>3.0</max_acceleration>

            <!-- 接收 ROS 2 速度指令 -->
            <topic>/cmd_vel</topic>

            <!-- 里程计 -->
            <odom_publish_frequency>50</odom_publish_frequency>
            <odom_topic>/model/my_orange_car/odometry</odom_topic>

            <frame_id>odom</frame_id>
            <child_frame_id>base_footprint</child_frame_id>
        </plugin>

        <plugin
            filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">

            <topic>/model/my_orange_car/joint_states</topic>
        </plugin>
    
    <link name="lidar_link">
            <pose>2.5 0 1.6 0 0 0</pose>
            <inertial>
                <mass>0.5</mass>
                <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia>
            </inertial>
            <collision name="lidar_collision">
                <geometry><cylinder><radius>0.05</radius><length>0.1</length></cylinder></geometry>
            </collision>
            <visual name="lidar_visual">
                <geometry><cylinder><radius>0.05</radius><length>0.1</length></cylinder></geometry>
                <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
            </visual>
            <sensor name="lidar_sensor" type="gpu_lidar">
                <always_on>true</always_on>
                <update_rate>10</update_rate>
                <topic>/scan</topic>
                <visualize>false</visualize> <lidar>
                    <scan>
                        <horizontal>
                            <samples>360</samples>
                            <resolution>1</resolution>
                            <min_angle>-3.1415926</min_angle>
                            <max_angle>3.1415926</max_angle>
                        </horizontal>
                    </scan>
                    <range>
                        <min>0.4</min> <max>15.0</max>
                        <resolution>0.01</resolution>
                    </range>
                </lidar>
            </sensor>
        </link>
        <joint name="lidar_joint" type="fixed">
            <parent>chassis</parent>
            <child>lidar_link</child>
        </joint>
    </model>
</sdf>
